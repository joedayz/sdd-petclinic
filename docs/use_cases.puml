@startuml Use Cases Overview
left to right direction
skinparam packageStyle rectangle

actor "Visitante" as visitor
actor "Usuario de la clínica" as user

rectangle "Spring PetClinic" {

    package "General" {
        usecase "UC-001\nVer página de bienvenida" as UC001
        usecase "UC-002\nVer veterinarios" as UC002
    }

    package "Gestión de dueños" {
        usecase "UC-003\nRegistrar nuevo dueño" as UC003
        usecase "UC-004\nBuscar dueños por apellido" as UC004
        usecase "UC-005\nVer detalle del dueño" as UC005
        usecase "UC-006\nActualizar dueño" as UC006
    }

    package "Gestión de mascotas" {
        usecase "UC-007\nAñadir mascota al dueño" as UC007
        usecase "UC-008\nActualizar mascota" as UC008
    }

    package "Gestión de consultas" {
        usecase "UC-009\nReservar consulta para mascota" as UC009
    }
}

' Visitante — acceso anónimo, solo lectura
visitor --> UC001
visitor --> UC002

' Usuario de la clínica — hereda acceso de visitante más casos de gestión
user --> UC001
user --> UC002
user --> UC003
user --> UC004
user --> UC005
user --> UC006
user --> UC007
user --> UC008
user --> UC009

' Relaciones
UC007 ..> UC005 : <<extend>>
UC008 ..> UC005 : <<extend>>
UC009 ..> UC005 : <<extend>>
UC006 ..> UC005 : <<extend>>

@enduml
